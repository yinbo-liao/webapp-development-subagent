[pytest]
minversion = 7.0
addopts =
    -ra
    -q
    --strict-markers
    --tb=short
    --cov=app
    --cov-report=term-missing
    --cov-report=html:htmlcov
    --cov-report=xml:coverage.xml
    --cov-fail-under={{ coverage_threshold | default(80) }}
    --asyncio-mode=auto
testpaths =
    app/tests
markers =
    unit: Unit tests
    integration: Integration tests
    e2e: End-to-end tests
    slow: Slow tests
    security: Security tests
