from fastapi import FastAPI, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from contextlib import asynccontextmanager
import uuid
import structlog

from app.core.config import settings
from app.core.database import engine, Base
{% for middleware in middlewares %}
{{ middleware.import_line }}
{%- endfor %}
{% for router in routers %}
from app.routers import {{ router.file_name }}
{%- endfor %}

logger = structlog.get_logger()


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan with database initialization."""
    logger.info("app_starting", version=settings.APP_VERSION)
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    yield
    await engine.dispose()
    logger.info("app_shutdown")


app = FastAPI(
    title="Enterprise API",
    description="Production-ready API with comprehensive security",
    version="1.0.0",
    lifespan=lifespan,
    docs_url="/docs",
    redoc_url="/redoc",
)

{% for middleware in middlewares %}
app.add_middleware({{ middleware.class_name }}{{ middleware.args }})
{% endfor %}

app.add_middleware(
    CORSMiddleware,
    allow_origins=settings.ALLOWED_ORIGINS,
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE"],
    allow_headers=["*"],
)

{% for router in routers %}
app.include_router({{ router.file_name }}.router, prefix="/{{ router.prefix }}", tags=["{{ router.tag }}"])
{% endfor %}


@app.get("/health")
async def health_check():
    return {"status": "healthy", "version": settings.APP_VERSION}


@app.get("/")
async def root():
    return {
        "app": settings.APP_NAME,
        "version": settings.APP_VERSION,
        "docs": "/docs",
        "health": "/health",
    }


@app.exception_handler(Exception)
async def global_exception_handler(request: Request, exc: Exception):
    """Structured error responses with request ID for tracing."""
    request_id = str(uuid.uuid4())
    logger.error("unhandled_exception", request_id=request_id, error=str(exc), path=request.url.path)
    return JSONResponse(
        status_code=500,
        content={
            "error": "Internal server error",
            "request_id": request_id,
            "type": "internal_error",
        },
    )
